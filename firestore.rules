rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Settings collection (profile, carta do dia)
    match /settings/{document=**} {
      allow read: if true;
      allow write: if true;
    }

    // Appointments collection (client bookings & admin agenda)
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Messages collection (chat with mentor)
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Calls collection (video call sessions and WebRTC signaling)
    match /calls/{callId} {
      allow read, write: if true;
    }

    // Posts collection (gallery feed)
    match /posts/{postId} {
      allow read, write: if true;
    }

    // Trabalhos collection
    match /trabalhos/{trabalhoId} {
      allow read, write: if true;
    }

    // Fallback for any other collections
    match /{path=**} {
      allow read, write: if true;
    }
  }
}
